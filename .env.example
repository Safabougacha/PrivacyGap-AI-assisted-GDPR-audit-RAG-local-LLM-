# Copy this file to .env.  .env is ignored by Git.

# Default: a local model with Ollama (free, no account, no API key)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b

# Optional: Google Gemini instead (needs a key from aistudio.google.com)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=paste-your-key-here
# CHAT_MODEL=gemini-2.5-flash
